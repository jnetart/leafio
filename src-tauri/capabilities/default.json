{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "store:default",
    "core:webview:deny-internal-toggle-devtools"
  ]
}
